rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones auxiliares ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function isStaff() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function isApoderado(alumnoId) {
      return isAuthenticated() &&
        request.auth.token.email == alumnoId + '@apo.marello.pe';
    }

    // Verifica que el email sea de apoderado (dominio virtual)
    function esEmailApoderado() {
      return isAuthenticated() &&
        request.auth.token.email.matches('.*@apo\\.marello\\.pe');
    }

    // Extrae el DNI del alumno desde el email del apoderado
    function dniDesdeEmail() {
      return request.auth.token.email.replace('@apo.marello.pe', '');
    }

    // ── Registros de asistencia ───────────────────────────────────────────────
    match /registros/{docId} {
      // get: staff o el apoderado dueño del registro
      allow get: if isStaff() ||
        (esEmailApoderado() && resource.data.alumnoId + '@apo.marello.pe' == request.auth.token.email);

      // list: staff sin restricción / apoderado solo con límite razonable
      // Nota: Firestore no permite filtrar por query.where en reglas;
      // la app siempre consulta con where('alumnoId','==',dni).
      // El límite de 500 evita lecturas masivas accidentales o maliciosas.
      allow list: if isStaff() ||
        (esEmailApoderado() && request.query.limit <= 500);

      allow create: if isStaff()
        && request.resource.data.keys().hasAll(['alumnoId','tipo','fecha','hora'])
        && request.resource.data.tipo in ['INGRESO', 'SALIDA']
        && !('passBackup' in request.resource.data);
      allow update, delete: if isAdmin();
    }

    // ── Apoderados ────────────────────────────────────────────────────────────
    match /apoderados/{alumnoId} {
      allow read:           if isStaff() || isApoderado(alumnoId);
      allow create, update: if isApoderado(alumnoId);
      allow create, update: if isStaff() && !('passBackup' in request.resource.data);
      allow delete:         if isAdmin();
    }

    // ── Alumnos ───────────────────────────────────────────────────────────────
    match /alumnos/{alumnoId} {
      // Solo admins crean/editan/eliminan alumnos
      // Staff puede listar/leer (para registrar asistencia)
      // Apoderado: solo puede leer el doc de su propio alumno (no listar todos)
      allow get:   if isStaff() || isApoderado(alumnoId);
      allow list:  if isStaff();
      allow write: if isAdmin();
    }

    // ── Usuarios (personal del colegio) ───────────────────────────────────────
    match /usuarios/{userId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ── Configuración del colegio ─────────────────────────────────────────────
    match /config/{docId} {
      // Staff: todo
      // Apoderado: solo config/general (nombre, logo, contacto)
      // Otros docs de config (factiliza, etc.) solo staff
      allow read: if isStaff() ||
        (esEmailApoderado() && docId == 'general');
      allow write: if isAdmin();
    }

    // ── Horarios ──────────────────────────────────────────────────────────────
    // Solo staff — los apoderados no necesitan leer horarios directamente
    match /horarios/{docId} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    // ── Incidentes ────────────────────────────────────────────────────────────
    match /incidentes/{docId} {
      // get: staff o el apoderado dueño del incidente
      allow get: if isStaff() ||
        (esEmailApoderado() && resource.data.alumnoId + '@apo.marello.pe' == request.auth.token.email);

      // list: igual que registros — apoderado con límite
      allow list: if isStaff() ||
        (esEmailApoderado() && request.query.limit <= 200);

      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // ── Resumen mensual (pre-agregado por alumno/mes) ────────────────────────
    match /resumen_mensual/{docId} {
      allow read, write: if isStaff();
      // docId formato: "YYYY-MM_alumnoId"
      allow read: if esEmailApoderado() &&
        docId.split('_')[1] + '@apo.marello.pe' == request.auth.token.email;
    }

    // ── Bloquear todo lo demás ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
