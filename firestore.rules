rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funciones auxiliares ──────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function isStaff() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // Verifica si el usuario autenticado ES el apoderado de ese alumno
    // (por email virtual: {dni}@apo.marello.pe)
    function isApoderado(alumnoId) {
      return isAuthenticated() &&
        request.auth.email == alumnoId + '@apo.marello.pe';
    }

    // ── Registros de asistencia ───────────────────────────────────────────────
    // Personal lee/escribe; apoderado solo puede listar (la app filtra por alumnoId)
    match /registros/{docId} {
      allow get:  if isStaff() ||
        (isAuthenticated() && resource.data.alumnoId + '@apo.marello.pe' == request.auth.email);
      allow list: if isStaff() ||
        (isAuthenticated() && request.auth.email.matches('.*@apo\\.marello\\.pe'));
      allow create: if isStaff()
        && request.resource.data.keys().hasAll(['alumnoId','tipo','fecha','hora'])
        && request.resource.data.tipo in ['INGRESO', 'SALIDA']
        // No permitir el campo passBackup en registros
        && !('passBackup' in request.resource.data);
      allow update, delete: if isAdmin();
    }

    // ── Apoderados ────────────────────────────────────────────────────────────
    match /apoderados/{alumnoId} {
      allow read:           if isStaff() || isApoderado(alumnoId);
      allow create, update: if isApoderado(alumnoId);
      allow create, update: if isStaff() && !('passBackup' in request.resource.data);
      allow delete:         if isAdmin();
    }

    // ── Alumnos ───────────────────────────────────────────────────────────────
    match /alumnos/{alumnoId} {
      allow read: if isAuthenticated();
      allow write: if isStaff();
      // El apoderado puede actualizar solo los campos de contacto de su alumno
      allow update: if isApoderado(alumnoId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'telefono','telefono2','apoderadoNombres','apoderadoApellidos',
          'apoderado2Nombres','apoderado2Apellidos','correoApoderado'
        ]);
    }

    // ── Usuarios (personal del colegio) ───────────────────────────────────────
    match /usuarios/{userId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ── Configuración del colegio ─────────────────────────────────────────────
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Horarios ──────────────────────────────────────────────────────────────
    match /horarios/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ── Incidentes ────────────────────────────────────────────────────────────
    match /incidentes/{docId} {
      allow get:  if isStaff() ||
        (isAuthenticated() && resource.data.alumnoId + '@apo.marello.pe' == request.auth.email);
      allow list: if isStaff() ||
        (isAuthenticated() && request.auth.email.matches('.*@apo\\.marello\\.pe'));
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // ── Bloquear todo lo demás ────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
