rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Incidentes: imágenes y PDFs ──────────────────────────────────────────
    // - Escritura: solo personal autenticado (staff)
    // - Lectura: staff autenticado O cualquiera con el link directo
    //   (los PDFs se comparten por WhatsApp → necesitan ser accesibles sin auth)
    // - Los archivos físicamente se borran al eliminar el incidente (desde el cliente)
    //   La expiración de 7 días es lógica (campo imagenesActivas en Firestore)
    match /incidentes/{incidenteId}/{archivo} {
      allow read:   if request.auth != null;
      allow write:  if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024; // máx 5MB por archivo
      allow delete: if request.auth != null;
    }

    // ── Bloquear todo lo demás ───────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
